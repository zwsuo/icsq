# Maintainer: zwsuo <izwsuo@gmail.com>
# 发布前把所有 TODO / 占位符替换掉，并确认 Cargo.lock 已提交到源码仓库。

pkgname=icsq
pkgver=1.1.4
pkgrel=1
pkgdesc='Query .ics calendar, journal, and todo files from the command line'
arch=('x86_64' 'aarch64')
url='https://github.com/zwsuo/icsq'
license=('MIT')
depends=('gcc-libs')
makedepends=('rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('REPLACE_ME') # TODO: 运行 updpkgsums 或 makepkg -g 填写

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --offline
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked --offline
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/icsq "$pkgdir/usr/bin/icsq"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
